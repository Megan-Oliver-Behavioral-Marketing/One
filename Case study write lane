    .cs-content p strong { font-weight: 500; color: var(--ink); }
    .cs-rule { border: none; border-top: 1px solid var(--rule); margin: 2.5rem 0; }

    .cs-callout { background: var(--green-pale); border-left: 3px solid var(--green); padding: 1.5rem 1.75rem; margin: 1.75rem 0; }
    .cs-callout-label { font-family: 'DM Mono', monospace; font-size: 0.58rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--green); margin-bottom: 0.5rem; }
    .cs-callout p { font-size: 0.9rem; color: var(--ink-mid); margin-bottom: 0; }

    .cs-insight { background: var(--ink); padding: 2rem 2.25rem; margin: 2rem 0; }
