    .cs-insight p { font-family: 'Cormorant Garamond', serif; font-size: 1.3rem; font-style: italic; color: var(--cream); line-height: 1.5; margin-bottom: 0; }

    .outcomes-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5px; background: var(--rule); margin: 1.5rem 0; }
    .outcome-card { background: var(--green); padding: 2rem 1.75rem; text-align: center; }
    .outcome-num { font-family: 'Cormorant Garamond', serif; font-size: 2.75rem; font-weight: 700; color: var(--cream); line-height: 1; margin-bottom: 0.4rem; }
    .outcome-label { font-family: 'DM Mono', monospace; font-size: 0.6rem; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(255,255,255,0.55); margin-bottom: 0.5rem; }
    .outcome-note { font-size: 0.8rem; font-weight: 300; color: rgba(255,255,255,0.65); line-height: 1.5; }

